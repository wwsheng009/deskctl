{
  "name": "desktop_semantic_observe",
  "description": "Read the Windows UIA tree and candidate actions for a bound target; tree_cursor continues the native tree page, delivery_mode becomes the default for later actions.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "goal": {
        "type": "string"
      },
      "target_token": {
        "type": "string"
      },
      "scope": {
        "type": "string",
        "enum": [
          "window",
          "menu"
        ]
      },
      "subtree_id": {
        "type": "string"
      },
      "observation_token": {
        "type": "string"
      },
      "cursor": {
        "type": "integer",
        "minimum": 0
      },
      "view": {
        "type": "string",
        "enum": [
          "candidates",
          "regions"
        ]
      },
      "tree_cursor": {
        "type": "string",
        "description": "Continue reading the native UIA tree from next_tree_cursor without re-capturing"
      },
      "delivery_mode": {
        "type": "string",
        "enum": [
          "foreground",
          "auto",
          "background"
        ],
        "default": "auto"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_semantic_observe",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

          "window",
          "menu"
        ]
      },
      "subtree_id": {
        "type": "string"
      },
      "observation_token": {
        "type": "string"
      },
      "cursor": {
        "type": "integer",
        "minimum": 0
      },
      "view": {
        "type": "string",
        "enum": [
          "candidates",
          "regions"
        ]
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_semantic_observe",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }

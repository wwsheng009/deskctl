{
  "name": "desktop_input",
  "description": "Type text, send a hotkey, or press/release a single key (name, VK code, or scancode) to the foreground or a target window.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "type",
          "hotkey",
          "key",
          "key_down",
          "key_up"
        ]
      },
      "target_locator": {
        "type": "object",
        "properties": {
          "app_id": {
            "type": "string"
          },
          "window_id": {
            "type": "string"
          },
          "window_title": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "window",
              "button",
              "text_field",
              "check_box",
              "radio_button",
              "list",
              "list_item",
              "menu",
              "menu_item",
              "tab",
              "document",
              "other"
            ]
          },
          "automation_id": {
            "type": "string"
          },
          "accessible_name": {
            "type": "string"
          },
          "ancestor_chain": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "supported_action": {
            "type": "string",
            "enum": [
              "invoke",
              "toggle",
              "set_checked",
              "select",
              "expand",
              "collapse",
              "focus",
              "set_value",
              "scroll",
              "scroll_into_view",
              "set_range_value"
            ]
          },
          "ordinal_hint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "app_id"
        ],
        "additionalProperties": false
      },
      "hwnd": {
        "type": "integer"
      },
      "launch_ref": {
        "type": "string",
        "description": "Optional app_ref from desktop_targets_list; relaunches the app when the target window is missing"
      },
      "text": {
        "type": "string",
        "maxLength": 65536
      },
      "send": {
        "type": "string",
        "enum": [
          "enter",
          "ctrl+enter",
          "tab",
          "none"
        ],
        "default": "enter"
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "key": {
        "type": "string",
        "description": "Single key: name (\"enter\"), vk:<0x41|65>, or scan:<0x1E|0xE01D>"
      },
      "extended": {
        "type": "boolean",
        "default": false,
        "description": "Force the extended-key flag (arrows, numpad, right-hand modifiers)"
      },
      "humanize": {
        "type": "string",
        "enum": [
          "off",
          "light",
          "natural"
        ],
        "default": "off",
        "description": "Human-like typing/hold pacing; off keeps legacy behavior"
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      },
      "delay_ms": {
        "description": "Per-character delay: fixed number or [min,max] range in milliseconds",
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minItems": 2,
            "maxItems": 2
          }
        ]
      },
      "hold_ms": {
        "type": "integer",
        "minimum": 5,
        "maximum": 5000
      },
      "repeat": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 1
      },
      "interval_ms": {
        "type": "integer",
        "minimum": 10,
        "maximum": 10000,
        "default": 120
      }
    },
    "required": [
      "mode"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_input",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

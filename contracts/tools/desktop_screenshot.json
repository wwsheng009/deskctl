{
  "name": "desktop_screenshot",
  "description": "Capture the screen or a screen region and save it as PNG.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "region": {
        "type": "object",
        "description": "Absolute screen region.",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "format": {
        "type": "string",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ],
        "description": "Output format; defaults to the daemon capture policy"
      },
      "quality": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "JPEG/WebP quality"
      },
      "max_width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 67108864,
        "description": "Hard cap; encoder reduces quality/dimensions until it fits"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_screenshot",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

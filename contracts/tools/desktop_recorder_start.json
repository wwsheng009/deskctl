        ],
        "default": "essential"
      },
      "max_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 200
      },
      "allow_relaunch": {
        "type": "boolean",
        "default": true,
        "description": "Record allow_relaunch=true for catalog-launched targets"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_recorder_start",

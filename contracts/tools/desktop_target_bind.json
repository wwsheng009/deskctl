{
  "name": "desktop_target_bind",
  "description": "Bind a running window, or launch a catalogued local app and bind its window, returning a target token.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "app_ref": {
        "type": "string"
      },
      "window_ref": {
        "type": "string"
      },
      "delivery_mode": {
        "type": "string",
        "enum": [
          "foreground",
          "auto",
          "background"
        ],
        "default": "foreground"
      },
      "follow_dialog": {
        "type": "boolean",
        "default": false,
        "description": "When the selected window is disabled by a modal dialog (native Save/Open), bind that dialog instead"
      }
    },
    "required": [
      "app_ref"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_target_bind",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

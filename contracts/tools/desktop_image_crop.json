{
  "name": "desktop_image_crop",
  "description": "Crop a region from a recorded capture or an allowed image and save it; capture sources stay chainable.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "capture_id": {
        "type": "string"
      },
      "image_path": {
        "type": "string"
      },
      "x": {
        "type": "integer"
      },
      "y": {
        "type": "integer"
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "path": {
        "type": "string"
      },
      "format": {
        "type": "string",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "quality": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "max_width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 67108864
      }
    },
    "required": [
      "x",
      "y",
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_image_crop",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

{
  "name": "desktop_xlsx_save",
  "description": "Write a .xlsx workbook from sheets of typed cell values, with bold header row, column widths, number formats and frozen header.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "sheets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "header_row": {
              "type": "boolean"
            },
            "freeze_header": {
              "type": "boolean"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 255
                  },
                  "number_format": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array"
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "path",
      "sheets"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_xlsx_save",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

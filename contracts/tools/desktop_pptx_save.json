{
  "name": "desktop_pptx_save",
  "description": "Write a .pptx deck with title/bullet/image slides and selectable layouts (auto, title_bullets, title_image, text_image, title_only); images may come from a capture_id or an allowed image path.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "slides": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "bullets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "layout": {
              "type": "string",
              "enum": [
                "auto",
                "title_bullets",
                "title_image",
                "text_image",
                "title_only"
              ]
            },
            "image": {
              "type": "object",
              "properties": {
                "capture_id": {
                  "type": "string"
                },
                "image_path": {
                  "type": "string"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "path",
      "slides"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_pptx_save",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

{
  "name": "desktop_window_screenshot",
  "description": "Capture one window and save it as PNG. Optional region crops the captured image; x/y are relative to the capture. Use desktop_window_info client_rect for client-area screen coordinates.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "hwnd": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "region": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "format": {
        "type": "string",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "quality": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "max_width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 67108864
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_window_screenshot",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

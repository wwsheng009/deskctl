{
  "name": "desktop_read_kv",
  "description": "Pair OCR labels with their adjacent values (right side or below) on a capture or image and return structured key-value data.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "image_path": {
        "type": "string",
        "description": "Path inside an allowed image root"
      },
      "capture_id": {
        "type": "string",
        "description": "Session capture (screenshot/crop) to read; bypasses the image-root policy"
      },
      "region": {
        "type": "object",
        "description": "Absolute screen region.",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "value_gap": {
        "type": "integer",
        "minimum": 8,
        "maximum": 4000,
        "default": 600,
        "description": "Max horizontal (or vertical) distance between a label and its value"
      },
      "row_tolerance": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "default": 0,
        "description": "Row clustering tolerance in pixels; 0 = auto from median text height"
      },
      "min_confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.3
      },
      "max_pairs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "default": 500
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_read_kv",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

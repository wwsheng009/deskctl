{
  "name": "desktop_xlsx_read",
  "description": "Read worksheets and cell values from .xlsx/.xls/.ods workbooks, optionally limited to a cell range like A1:C10 (bounded rows/cols).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "sheet": {
        "type": "string"
      },
      "range": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_xlsx_read",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

{
  "name": "desktop_find_color",
  "description": "Find a color in a screen region.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "color": {
        "type": "string",
        "minLength": 1
      },
      "region": {
        "type": "object",
        "description": "Absolute screen region.",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "direction": {
        "type": "string",
        "enum": [
          "left_top",
          "left_bottom",
          "right_top",
          "right_bottom",
          "column_left_top",
          "column_right_top",
          "column_left_bottom",
          "column_right_bottom",
          "center"
        ],
        "default": "left_top"
      }
    },
    "required": [
      "color"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "desktop_find_color",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}

      },
      "title": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "image": {
              "type": "object",
              "properties": {
                "capture_id": {
                  "type": "string"
                },
                "image_path": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "width_cm": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 18
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },
    "required": [
